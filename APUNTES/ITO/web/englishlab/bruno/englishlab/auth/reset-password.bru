// Clave NUEVA que se fija tras el reset: variable {{newPassword}} del entorno.
meta {
  name: reset-password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/reset-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "PEGAR_TOKEN_DE_forgot-password",
    "newPassword": "{{newPassword}}"
  }
}
